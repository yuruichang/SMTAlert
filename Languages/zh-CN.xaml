<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!-- App -->
    <s:String x:Key="App_Title">SMT 警报</s:String>
    <s:String x:Key="App_TrayShow">显示</s:String>
    <s:String x:Key="App_TrayExit">退出</s:String>

    <!-- Main Window -->
    <s:String x:Key="Main_Menu_Overlay">打开雷达浮窗</s:String>
    <s:String x:Key="Main_Menu_ZKB">打开ZKB监控</s:String>
    <s:String x:Key="Main_Menu_Settings">设置</s:String>
    <s:String x:Key="Main_Menu_AddChar">添加角色</s:String>
    <s:String x:Key="Main_Menu_AlertChannel">警报频道消息</s:String>
    <s:String x:Key="AlertCh_Title">警报频道监控</s:String>
    <s:String x:Key="AlertCh_Channel">频道:</s:String>
    <s:String x:Key="AlertCh_ClearKeywords">清除:</s:String>
    <s:String x:Key="Main_CharList">角色</s:String>
    <s:String x:Key="Main_NoChar">未添加角色。点击“添加角色”使用EVE SSO登录。</s:String>
    <s:String x:Key="Main_CharDelete">删除角色</s:String>
    <s:String x:Key="Main_CharDeleteConfirm">确定要移除此角色吗？</s:String>

    <!-- Logon Window -->
    <s:String x:Key="Logon_Title">SMTAlert - EVE SSO 登录</s:String>
    <s:String x:Key="Logon_Line1">SMTAlert 正在打开浏览器进行 EVE SSO 登录。</s:String>
    <s:String x:Key="Logon_Line2">授权完成后关闭此窗口。</s:String>

    <!-- Overlay Window -->
    <s:String x:Key="Overlay_Title">SMTAlert 雷达</s:String>
    <s:String x:Key="Overlay_NoChar">无活动角色</s:String>
    <s:String x:Key="Overlay_AlertLabel">警报</s:String>
    <s:String x:Key="Overlay_TipDrag">拖拽移动叠加层。</s:String>
    <s:String x:Key="Overlay_TipToggle">切换雷达显示模式。</s:String>
    <s:String x:Key="Overlay_TipClose">关闭叠加层。</s:String>
    <s:String x:Key="Overlay_TipNames">切换星系名称标签。</s:String>

    <!-- ZKB Monitor -->
    <s:String x:Key="ZKB_Title">ZKB 监控</s:String>
    <s:String x:Key="ZKB_Column_Time">时间</s:String>
    <s:String x:Key="ZKB_Column_System">星系</s:String>
    <s:String x:Key="ZKB_Column_CharacterID">角色</s:String>
    <s:String x:Key="ZKB_Column_Region">星域</s:String>
    <s:String x:Key="ZKB_Column_Alliance">联盟</s:String>
    <s:String x:Key="ZKB_Column_Corp">公司</s:String>
    <s:String x:Key="ZKB_Column_ShipType">舰船类型</s:String>
    <s:String x:Key="ZKB_Column_Value">价值</s:String>
    <s:String x:Key="ZKB_Column_AttackerAlliance">击杀者联盟</s:String>
    <s:String x:Key="ZKB_CtxShowSys">显示星系详情</s:String>
    <s:String x:Key="ZKB_CtxOpen">在ZKB上打开击杀</s:String>
    <s:String x:Key="ZKB_CtxCopyLink">复制游戏内链接</s:String>

    <!-- Settings Window -->
    <s:String x:Key="Settings_Title">SMTAlert 设置</s:String>
    <s:String x:Key="Settings_Tab_General">常规</s:String>
    <s:String x:Key="Settings_Tab_Overlay">雷达浮窗</s:String>
    <s:String x:Key="Settings_Tab_ZKB">ZKB 监控</s:String>
    <s:String x:Key="Settings_Tab_Characters">角色管理</s:String>
    <s:String x:Key="Settings_General_Lang">语言</s:String>
    <s:String x:Key="Settings_General_AlwaysOnTop">始终置顶</s:String>
    <s:String x:Key="Settings_General_MinimizeToTray">最小化到托盘</s:String>
    <s:String x:Key="Settings_General_AlertVolume">警报音量</s:String>
    <s:String x:Key="Settings_General_LogFolder">EVE 日志文件夹</s:String>
    <s:String x:Key="Settings_Alert_Channel">警报频道名称</s:String>
    <s:String x:Key="Settings_Alert_ClearKeywords">清除警报关键词</s:String>
    <s:String x:Key="Settings_Alert_ClearKeywordsTip">多个关键词用逗号分隔，例如: clear, safe, green</s:String>
    <s:String x:Key="Settings_Alert_FreshMin">警报活跃时间（分）</s:String>
    <s:String x:Key="Settings_Alert_StaleMin">警报可见时间（分）</s:String>
    <s:String x:Key="Settings_Ovl_BgOpacity">背景不透明度</s:String>
    <s:String x:Key="Settings_Ovl_ContentOpacity">内容不透明度</s:String>
    <s:String x:Key="Settings_Ovl_GathererMode">防御模式</s:String>
    <s:String x:Key="Settings_Ovl_ShowFullRegion">显示完整星域</s:String>
    <s:String x:Key="Settings_Ovl_ShowSysNames">显示星系名称</s:String>
    <s:String x:Key="Settings_ZKB_BgOpacity">背景不透明度</s:String>
    <s:String x:Key="Settings_ZKB_ContentOpacity">内容不透明度</s:String>
    <s:String x:Key="Settings_ZKB_MaxKills">最大击杀显示数</s:String>
    <s:String x:Key="Settings_ZKB_ExpireMin">击杀过期时间（分）</s:String>
    <s:String x:Key="Settings_ZKB_FilterRegion">按警告区域过滤</s:String>
    <s:String x:Key="Settings_ZKB_CustomSystems">监控星系/星域</s:String>
    <s:String x:Key="Settings_ZKB_CustomSystemsTip">多个名称用逗号分隔。支持中英文，例如: The Forge, Lonetrek, Jita</s:String>
    <s:String x:Key="Settings_ZKB_MonitoredChars">角色/公司监控</s:String>
    <s:String x:Key="Settings_ZKB_MonitoredCharIDs">监控角色ID</s:String>
    <s:String x:Key="Settings_ZKB_MonitoredCharIDsTip">多个角色ID用逗号分隔，不受星系过滤限制</s:String>
    <s:String x:Key="Settings_ZKB_MonitoredCorpIDs">监控公司ID</s:String>
    <s:String x:Key="Settings_ZKB_MonitoredCorpIDsTip">多个公司ID用逗号分隔，不受星系过滤限制</s:String>
    <s:String x:Key="Settings_ZKB_Columns">显示列（↑↓调整顺序）</s:String>
    <s:String x:Key="Settings_ZKB_FontSize">字体大小</s:String>
    <s:String x:Key="Settings_ZKB_UseLocalTime">使用本地时间显示（否则使用游戏时间UTC+0）</s:String>

    <!-- Character Alert Settings -->
    <s:String x:Key="Char_AlertRange">警报范围（跳）</s:String>
    <s:String x:Key="Char_AlertEnabled">启用警报</s:String>
    <s:String x:Key="Char_Location">位置</s:String>
    <s:String x:Key="Char_Online">在线</s:String>
    <s:String x:Key="Char_SetActive">设为监控目标</s:String>
    <s:String x:Key="Char_ActiveTag">[活跃]</s:String>
    <s:String x:Key="Char_Back">← 返回</s:String>
    <s:String x:Key="Char_Jumps">跳</s:String>
    <s:String x:Key="Char_Monitor">启用监控</s:String>

    <!-- Settings Footer -->
    <s:String x:Key="Settings_Version">版本</s:String>

    <!-- Update Check -->
    <s:String x:Key="Update_Title">更新可用</s:String>
    <s:String x:Key="Update_Available">有新版本可用！\n\n当前版本: {0}\n最新版本: {1}\n\n打开发布页面下载？</s:String>

</ResourceDictionary>