<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Window -->
    <sys:String x:Key="App_Title">SMT 预警</sys:String>
    <sys:String x:Key="Menu_Settings">设置</sys:String>
    <sys:String x:Key="Menu_Exit">退出</sys:String>

    <!-- Character Bar -->
    <sys:String x:Key="Char_NoChar">未选择角色</sys:String>
    <sys:String x:Key="Char_Location">位置</sys:String>
    <sys:String x:Key="Char_Region">星域</sys:String>
    <sys:String x:Key="Char_Range">预警范围</sys:String>
    <sys:String x:Key="Char_Jumps">跳</sys:String>
    <sys:String x:Key="Char_WarningSystems">预警星系</sys:String>

    <!-- Intel Panel -->
    <sys:String x:Key="Intel_Title">预警频道</sys:String>
    <sys:String x:Key="Intel_Time">时间</sys:String>
    <sys:String x:Key="Intel_System">星系</sys:String>
    <sys:String x:Key="Intel_Content">内容</sys:String>
    <sys:String x:Key="Intel_InRange">范围内</sys:String>
    <sys:String x:Key="Intel_Clear">清除</sys:String>

    <!-- ZKB Panel -->
    <sys:String x:Key="ZKB_Title">击杀推送</sys:String>
    <sys:String x:Key="ZKB_System">星系</sys:String>
    <sys:String x:Key="ZKB_Alliance">联盟</sys:String>
    <sys:String x:Key="ZKB_ShipType">船型</sys:String>
    <sys:String x:Key="ZKB_Time">时间</sys:String>

    <!-- Settings - Intel Channel -->
    <sys:String x:Key="Settings_IntelChannel">情报频道</sys:String>
    <sys:String x:Key="Settings_ChannelFilter">频道名称关键字（逗号分隔）:</sys:String>
    <sys:String x:Key="Settings_ChannelFilterTip">聊天日志文件名包含这些关键字的将被视为情报频道。例如: Intel, 预警, Alliance</sys:String>
    <sys:String x:Key="Settings_AlertKeywords">预警关键字（逗号分隔）:</sys:String>
    <sys:String x:Key="Settings_AlertKeywordsTip">内容包含这些关键字时触发高级别预警（红色闪烁）。留空则所有情报均视为普通预警</sys:String>
    <sys:String x:Key="Settings_ClearKeywords">清除关键字（逗号分隔）:</sys:String>
    <sys:String x:Key="Settings_ClearKeywordsTip">内容包含这些关键字时将情报标记为已清除状态</sys:String>

    <!-- Settings -->
    <sys:String x:Key="Settings_Title">设置</sys:String>
    <sys:String x:Key="Settings_Language">界面语言</sys:String>
    <sys:String x:Key="Settings_Lang_CN">中文</sys:String>
    <sys:String x:Key="Settings_Lang_EN">English</sys:String>
    <sys:String x:Key="Settings_Save">保存</sys:String>
    <sys:String x:Key="Settings_Cancel">取消</sys:String>
    <sys:String x:Key="Settings_Alert">预警设置</sys:String>
    <sys:String x:Key="Settings_AlertRange">预警范围(跳):</sys:String>
    <sys:String x:Key="Settings_MaxIntelTime">最大预警时间(秒):</sys:String>
    <sys:String x:Key="Settings_PlaySound">播放预警声音</sys:String>
    <sys:String x:Key="Settings_SoundVolume">预警音量:</sys:String>
    <sys:String x:Key="Settings_Intel">预警窗口</sys:String>
    <sys:String x:Key="Settings_ZKB">ZKB 击杀推送</sys:String>
    <sys:String x:Key="Settings_MaxKills">最大击杀数:</sys:String>
    <sys:String x:Key="Settings_ExpireMinutes">击杀过期时间(分钟):</sys:String>
    <sys:String x:Key="Settings_FilterByRegion">仅显示当前星域</sys:String>
    <sys:String x:Key="Settings_BackgroundOpacity">背景透明度:</sys:String>
    <sys:String x:Key="Settings_ContentOpacity">内容透明度:</sys:String>
    <sys:String x:Key="Settings_General">常规</sys:String>
    <sys:String x:Key="Settings_AlwaysOnTop">窗口置顶</sys:String>

    <!-- Map -->
    <sys:String x:Key="Map_ViewRegion">星域视图</sys:String>
    <sys:String x:Key="Map_ViewRange">范围视图</sys:String>
    <sys:String x:Key="Map_SelectRegion">选择星域</sys:String>
    <sys:String x:Key="Map_IntelAlert_p">有预警</sys:String>
    <sys:String x:Key="Map_IntelClear_p">已清除</sys:String>
    <sys:String x:Key="Map_IntelStale_p">超时未清</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_ClearIntel">清除预警</sys:String>
    <sys:String x:Key="Btn_AddChar">添加角色 (ESI)</sys:String>
    <sys:String x:Key="Btn_RemoveChar">移除角色</sys:String>
    <sys:String x:Key="Btn_ToggleIntel">预警窗</sys:String>
    <sys:String x:Key="Btn_ToggleZKB">击杀窗</sys:String>
    <sys:String x:Key="Btn_ShowIntel">预警窗 ▸</sys:String>
    <sys:String x:Key="Btn_ShowZKB">击杀窗 ▸</sys:String>
</ResourceDictionary>
