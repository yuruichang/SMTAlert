<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Window -->
    <sys:String x:Key="App_Title">SMT Alert</sys:String>
    <sys:String x:Key="Menu_Settings">Settings</sys:String>
    <sys:String x:Key="Menu_Exit">Exit</sys:String>

    <!-- Character Bar -->
    <sys:String x:Key="Char_NoChar">No Character Selected</sys:String>
    <sys:String x:Key="Char_Location">Location</sys:String>
    <sys:String x:Key="Char_Region">Region</sys:String>
    <sys:String x:Key="Char_Range">Alert Range</sys:String>
    <sys:String x:Key="Char_Jumps">jumps</sys:String>
    <sys:String x:Key="Char_WarningSystems">Warning Systems</sys:String>

    <!-- Intel Panel -->
    <sys:String x:Key="Intel_Title">Intel Channel</sys:String>
    <sys:String x:Key="Intel_Time">Time</sys:String>
    <sys:String x:Key="Intel_System">System</sys:String>
    <sys:String x:Key="Intel_Content">Content</sys:String>
    <sys:String x:Key="Intel_InRange">In Range</sys:String>
    <sys:String x:Key="Intel_Clear">Clear</sys:String>

    <!-- ZKB Panel -->
    <sys:String x:Key="ZKB_Title">Kill Feed</sys:String>
    <sys:String x:Key="ZKB_System">System</sys:String>
    <sys:String x:Key="ZKB_Alliance">Alliance</sys:String>
    <sys:String x:Key="ZKB_ShipType">Ship Type</sys:String>
    <sys:String x:Key="ZKB_Time">Time</sys:String>

    <!-- Settings - Intel Channel -->
    <sys:String x:Key="Settings_IntelChannel">Intel Channel</sys:String>
    <sys:String x:Key="Settings_ChannelFilter">Channel name keywords (comma-separated):</sys:String>
    <sys:String x:Key="Settings_ChannelFilterTip">Chat log files whose names contain these keywords will be treated as intel channels. E.g.: Intel, Alliance, Local</sys:String>
    <sys:String x:Key="Settings_AlertKeywords">Alert keywords (comma-separated):</sys:String>
    <sys:String x:Key="Settings_AlertKeywordsTip">Content matching these keywords triggers high-priority alert. Leave empty for all intel as normal alert</sys:String>
    <sys:String x:Key="Settings_ClearKeywords">Clear keywords (comma-separated):</sys:String>
    <sys:String x:Key="Settings_ClearKeywordsTip">Content matching these keywords marks intel as cleared status</sys:String>

    <!-- Settings -->
    <sys:String x:Key="Settings_Title">Settings</sys:String>
    <sys:String x:Key="Settings_Language">Language</sys:String>
    <sys:String x:Key="Settings_Lang_CN">中文</sys:String>
    <sys:String x:Key="Settings_Lang_EN">English</sys:String>
    <sys:String x:Key="Settings_Save">Save</sys:String>
    <sys:String x:Key="Settings_Cancel">Cancel</sys:String>
    <sys:String x:Key="Settings_Alert">Alert Settings</sys:String>
    <sys:String x:Key="Settings_AlertRange">Alert Range (jumps):</sys:String>
    <sys:String x:Key="Settings_MaxIntelTime">Max Intel Time (sec):</sys:String>
    <sys:String x:Key="Settings_PlaySound">Play Alert Sound</sys:String>
    <sys:String x:Key="Settings_SoundVolume">Alert Volume:</sys:String>
    <sys:String x:Key="Settings_Intel">Intel Window</sys:String>
    <sys:String x:Key="Settings_ZKB">ZKB Kill Feed</sys:String>
    <sys:String x:Key="Settings_MaxKills">Max Kills:</sys:String>
    <sys:String x:Key="Settings_ExpireMinutes">Kill Expire (min):</sys:String>
    <sys:String x:Key="Settings_FilterByRegion">Filter by Current Region</sys:String>
    <sys:String x:Key="Settings_BackgroundOpacity">Background Opacity:</sys:String>
    <sys:String x:Key="Settings_ContentOpacity">Content Opacity:</sys:String>
    <sys:String x:Key="Settings_General">General</sys:String>
    <sys:String x:Key="Settings_AlwaysOnTop">Always on Top</sys:String>

    <!-- Map -->
    <sys:String x:Key="Map_ViewRegion">Region View</sys:String>
    <sys:String x:Key="Map_ViewRange">Range View</sys:String>
    <sys:String x:Key="Map_SelectRegion">Select Region</sys:String>
    <sys:String x:Key="Map_IntelAlert_p">Alert</sys:String>
    <sys:String x:Key="Map_IntelClear_p">Cleared</sys:String>
    <sys:String x:Key="Map_IntelStale_p">Stale</sys:String>

    <!-- Buttons -->
    <sys:String x:Key="Btn_ClearIntel">Clear Intel</sys:String>
    <sys:String x:Key="Btn_AddChar">Add Character (ESI)</sys:String>
    <sys:String x:Key="Btn_RemoveChar">Remove Character</sys:String>
    <sys:String x:Key="Btn_ToggleIntel">Intel</sys:String>
    <sys:String x:Key="Btn_ToggleZKB">ZKB</sys:String>
    <sys:String x:Key="Btn_ShowIntel">Intel ▸</sys:String>
    <sys:String x:Key="Btn_ShowZKB">ZKB ▸</sys:String>
</ResourceDictionary>
