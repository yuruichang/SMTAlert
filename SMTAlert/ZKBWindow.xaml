<Window x:Class="SMTAlert.ZKBWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SMTAlert.Converters"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        MinWidth="280" MinHeight="140"
        Title="ZKB Kill Feed" Height="350" Width="340"
        AllowsTransparency="True"
        Background="#F01A1A1A">

    <Window.Resources>
        <converters:StandingBackgroundConverter x:Key="standingBg" />
        <converters:StandingForegroundConverter x:Key="standingFg" />
    </Window.Resources>

    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#FF1A1A1A" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Text="☠" Foreground="#FFCC4444" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource ZKB_Title}" Foreground="#FF888888"
                           VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Foreground="#FFAAAAAA" Background="Transparent"
                    BorderThickness="0" Width="24" Height="22" Click="Close_Click" FontSize="12" />
        </Grid>

        <!-- Kill Feed List -->
        <ListView x:Name="ZKBList" Grid.Row="1" Background="Transparent"
                  BorderThickness="0" FontSize="10"
                  PreviewMouseRightButtonDown="ZKBList_PreviewMouseRightButtonDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="85">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource ZKB_System}" TextAlignment="Center" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SystemName}" TextAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="120">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource ZKB_Alliance}" TextAlignment="Center" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding VictimAllianceName}" TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="105">
                        <GridViewColumn.Header>
                            <TextBlock Text="{DynamicResource ZKB_ShipType}" TextAlignment="Center" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShipTypeDisplay}" TextTrimming="CharacterEllipsis"
                                           TextAlignment="Center" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Foreground"
                            Value="{Binding Converter={StaticResource standingFg}}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border x:Name="Bd"
                                        Background="{Binding Converter={StaticResource standingBg}}"
                                        BorderBrush="Transparent" BorderThickness="2"
                                        CornerRadius="1" Margin="1,1">
                                    <GridViewRowPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4488CC" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="Selector.IsSelectionActive" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF335577" />
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open in zKillboard" Click="OpenZKBLink_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
</Window>
