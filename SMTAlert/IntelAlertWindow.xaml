<Window x:Class="SMTAlert.IntelAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        MinWidth="280" MinHeight="200"
        Title="Intel Alert" Height="500" Width="580"
        AllowsTransparency="True"
        Background="#F01A1A1A">

    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="22" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#FF1A1A1A" MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <TextBlock Text="⚠" Foreground="#FFCC4444" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Intel_Title}" Foreground="#FF888888"
                           VerticalAlignment="Center" Margin="4,0,0,0" FontSize="11" />
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Foreground="#FFAAAAAA" Background="Transparent"
                    BorderThickness="0" Width="24" Height="22" Click="Close_Click" FontSize="12" />
        </Grid>

        <!-- Toolbar -->
        <Border x:Name="ToolbarBorder" Grid.Row="1" Background="#FF1E1E1E">
            <Grid Margin="4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Region name label -->
                <TextBlock x:Name="RegionNameLabel" Grid.Column="0" Foreground="#FF888888"
                           FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0" />

                <!-- View mode toggle -->
                <ToggleButton x:Name="RangeViewBtn" Grid.Column="1"
                              Content="{DynamicResource Map_ViewRange}" Foreground="#FF888888"
                              Background="#FF2D2D2D" BorderThickness="0" FontSize="10"
                              Width="60" Height="22" Margin="0,0,2,0"
                              IsChecked="True"
                              Checked="ViewMode_Changed" Unchecked="ViewMode_Changed" />
                <ToggleButton x:Name="RegionViewBtn" Grid.Column="2"
                              Content="{DynamicResource Map_ViewRegion}" Foreground="#FF888888"
                              Background="#FF2D2D2D" BorderThickness="0" FontSize="10"
                              Width="60" Height="22" Margin="0,0,4,0"
                              IsChecked="False"
                              Checked="ViewMode_Changed" Unchecked="ViewMode_Changed" />

                <!-- Zoom controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0">
                    <Button x:Name="ZoomOutBtn" Content="−" Foreground="#FFCCCCCC"
                            Background="#FF2D2D2D" BorderThickness="0" FontSize="12"
                            Width="22" Height="22" Click="ZoomOut_Click" FontWeight="Bold" />
                    <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="#FF888888"
                              FontSize="9" VerticalAlignment="Center" Width="32"
                              TextAlignment="Center" />
                    <Button x:Name="ZoomInBtn" Content="+" Foreground="#FFCCCCCC"
                            Background="#FF2D2D2D" BorderThickness="0" FontSize="12"
                            Width="22" Height="22" Click="ZoomIn_Click" FontWeight="Bold" />
                </StackPanel>


            </Grid>
        </Border>

        <!-- Star Map -->
        <Grid x:Name="MapBackground" Grid.Row="2" Background="#FF151515">
            <Canvas x:Name="MapCanvas" SizeChanged="MapCanvas_SizeChanged"
                    MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                    MouseMove="MapCanvas_MouseMove"
                    MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                    MouseWheel="MapCanvas_MouseWheel" />
            <!-- Map info overlay -->
            <TextBlock x:Name="MapInfoLabel" Foreground="#FF666666" FontSize="10"
                       VerticalAlignment="Bottom" HorizontalAlignment="Left"
                       Margin="6,0,0,4" IsHitTestVisible="False" />
            <!-- Legend -->
            <StackPanel x:Name="MapLegend" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                        Margin="0,0,6,4" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#FF505050" Stroke="#FFBF360C" StrokeThickness="2"
                             VerticalAlignment="Center" Margin="0,0,2,0" />
                    <TextBlock Text="{DynamicResource Map_IntelAlert_p}" Foreground="#FF888888" FontSize="9" Margin="0,0,6,0" />
                    <Ellipse Width="10" Height="10" Fill="#FF505050" Stroke="Orange" StrokeThickness="2"
                             VerticalAlignment="Center" Margin="0,0,2,0" />
                    <TextBlock Text="{DynamicResource Map_IntelClear_p}" Foreground="#FF888888" FontSize="9" Margin="0,0,6,0" />
                    <Ellipse Width="10" Height="10" Fill="#FF505050" Stroke="#FFDCDCDC" StrokeThickness="2"
                             VerticalAlignment="Center" Margin="0,0,2,0" />
                    <TextBlock Text="{DynamicResource Map_IntelStale_p}" Foreground="#FF888888" FontSize="9" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
