<Window x:Class="SMTAlert.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}" Height="700" Width="400"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E" Foreground="#FFCCCCCC">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- Language -->
            <GroupBox Header="{DynamicResource Settings_Language}"
                      Foreground="#FF888888" BorderBrush="#FF333333" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Margin="4,2">
                    <RadioButton x:Name="LangCN" Content="{DynamicResource Settings_Lang_CN}"
                                 Foreground="#FFCCCCCC" Margin="0,0,12,0" GroupName="Lang" />
                    <RadioButton x:Name="LangEN" Content="{DynamicResource Settings_Lang_EN}"
                                 Foreground="#FFCCCCCC" GroupName="Lang" />
                </StackPanel>
            </GroupBox>

            <!-- Intel Channel & Keyword Filters -->
            <GroupBox Header="{DynamicResource Settings_IntelChannel}" Foreground="#FF888888"
                      BorderBrush="#FF333333" Margin="0,0,0,4">
                <Grid Margin="4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{DynamicResource Settings_ChannelFilter}" Foreground="#FFAAAAAA"
                                   FontSize="10" Margin="0,0,0,2" />
                        <TextBox x:Name="ChannelFilterBox" Background="#FF2D2D2D"
                                 Foreground="#FFCCCCCC" BorderThickness="0" FontSize="10"
                                 ToolTip="{DynamicResource Settings_ChannelFilterTip}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{DynamicResource Settings_AlertKeywords}" Foreground="#FFAAAAAA"
                                   FontSize="10" Margin="0,0,0,2" />
                        <TextBox x:Name="AlertKeywordsBox" Background="#FF2D2D2D"
                                 Foreground="#FFCCCCCC" BorderThickness="0" FontSize="10"
                                 ToolTip="{DynamicResource Settings_AlertKeywordsTip}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="{DynamicResource Settings_ClearKeywords}" Foreground="#FFAAAAAA"
                                   FontSize="10" Margin="0,0,0,2" />
                        <TextBox x:Name="ClearKeywordsBox" Background="#FF2D2D2D"
                                 Foreground="#FFCCCCCC" BorderThickness="0" FontSize="10"
                                 ToolTip="{DynamicResource Settings_ClearKeywordsTip}" />
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- Alert Settings -->
            <GroupBox Header="{DynamicResource Settings_Alert}" Foreground="#FF888888"
                      BorderBrush="#FF333333" Margin="0,0,0,4">
                <Grid Margin="4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_AlertRange}"
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                    <Slider x:Name="AlertRangeSlider" Grid.Row="0" Grid.Column="1"
                            Minimum="1" Maximum="15" Value="5" Width="170"
                            ValueChanged="AlertRangeSlider_ValueChanged" />
                    <TextBlock x:Name="AlertRangeLabel" Grid.Row="0" Grid.Column="1"
                               Text="5" Foreground="#FFCCCCCC" HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_MaxIntelTime}"
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                    <TextBox x:Name="MaxIntelBox" Grid.Row="1" Grid.Column="1"
                             Text="120" Width="50" Background="#FF2D2D2D"
                             Foreground="#FFCCCCCC" BorderThickness="0" />

                    <CheckBox x:Name="PlaySoundChk" Grid.Row="2" Grid.Column="0"
                              Content="{DynamicResource Settings_PlaySound}" Foreground="#FFCCCCCC"
                              VerticalAlignment="Center" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings_SoundVolume}"
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                    <Slider x:Name="VolumeSlider" Grid.Row="3" Grid.Column="1"
                            Minimum="0" Maximum="1" Value="0.5" Width="170"
                            ValueChanged="VolumeSlider_ValueChanged" />
                    <TextBlock x:Name="VolumeLabel" Grid.Row="3" Grid.Column="1"
                               Text="0.5" Foreground="#FFCCCCCC" HorizontalAlignment="Right" />
                </Grid>
            </GroupBox>

            <!-- Intel Window -->
            <GroupBox Header="{DynamicResource Settings_Intel}" Foreground="#FF888888"
                      BorderBrush="#FF333333" Margin="0,0,0,4">
                <Grid Margin="4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_BackgroundOpacity}"
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                    <Slider x:Name="IntelBgOpacitySlider" Grid.Row="0" Grid.Column="1"
                            Minimum="0.05" Maximum="1" Value="0.15" Width="170"
                            ValueChanged="IntelBgOpacitySlider_ValueChanged" />
                    <TextBlock x:Name="IntelBgOpacityLabel" Grid.Row="0" Grid.Column="1"
                               Text="0.15" Foreground="#FFCCCCCC" HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_ContentOpacity}"
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                    <Slider x:Name="IntelContentOpacitySlider" Grid.Row="1" Grid.Column="1"
                            Minimum="0.1" Maximum="1" Value="0.85" Width="170"
                            ValueChanged="IntelContentOpacitySlider_ValueChanged" />
                    <TextBlock x:Name="IntelContentOpacityLabel" Grid.Row="1" Grid.Column="1"
                               Text="0.85" Foreground="#FFCCCCCC" HorizontalAlignment="Right" />
                </Grid>
            </GroupBox>

            <!-- ZKB Settings -->
            <GroupBox Header="{DynamicResource Settings_ZKB}" Foreground="#FF888888"
                      BorderBrush="#FF333333" Margin="0,0,0,4">
                <Grid Margin="4,2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="24" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Settings_MaxKills}"
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                    <TextBox x:Name="MaxKillsBox" Grid.Row="0" Grid.Column="1"
                             Text="50" Width="50" Background="#FF2D2D2D"
                             Foreground="#FFCCCCCC" BorderThickness="0" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Settings_ExpireMinutes}"
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                    <TextBox x:Name="ExpireBox" Grid.Row="1" Grid.Column="1"
                             Text="30" Width="50" Background="#FF2D2D2D"
                             Foreground="#FFCCCCCC" BorderThickness="0" />

                    <CheckBox x:Name="FilterByRegionChk" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                              Content="{DynamicResource Settings_FilterByRegion}" Foreground="#FFCCCCCC"
                              VerticalAlignment="Center" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource Settings_BackgroundOpacity}"
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                    <Slider x:Name="BgOpacitySlider" Grid.Row="3" Grid.Column="1"
                            Minimum="0.05" Maximum="1" Value="0.2" Width="170"
                            ValueChanged="BgOpacitySlider_ValueChanged" />
                    <TextBlock x:Name="BgOpacityLabel" Grid.Row="3" Grid.Column="1"
                               Text="0.2" Foreground="#FFCCCCCC" HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Settings_ContentOpacity}"
                               Foreground="#FFAAAAAA" VerticalAlignment="Center" />
                    <Slider x:Name="ContentOpacitySlider" Grid.Row="4" Grid.Column="1"
                            Minimum="0.1" Maximum="1" Value="0.85" Width="170"
                            ValueChanged="ContentOpacitySlider_ValueChanged" />
                    <TextBlock x:Name="ContentOpacityLabel" Grid.Row="4" Grid.Column="1"
                               Text="0.85" Foreground="#FFCCCCCC" HorizontalAlignment="Right" />
                </Grid>
            </GroupBox>

            <!-- General -->
            <GroupBox Header="{DynamicResource Settings_General}" Foreground="#FF888888"
                      BorderBrush="#FF333333" Margin="0,0,0,4">
                <Grid Margin="4,2">
                    <CheckBox x:Name="AlwaysOnTopChk" Content="{DynamicResource Settings_AlwaysOnTop}"
                              Foreground="#FFCCCCCC" VerticalAlignment="Center" />
                </Grid>
            </GroupBox>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="{DynamicResource Settings_Save}" Click="Save_Click"
                    Width="70" Height="26" Margin="0,0,8,0"
                    Background="#FF2D5F8A" Foreground="White" BorderThickness="0" />
            <Button Content="{DynamicResource Settings_Cancel}" Click="Cancel_Click"
                    Width="70" Height="26"
                    Background="#FF3A3A3A" Foreground="#FFCCCCCC" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
